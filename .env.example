# Copy to .env and fill in. .env is gitignored.

# Riot API key (optional — VCT pro matches are NOT available via the Riot API;
# this is only useful for pro players' ranked-queue form signals, and the
# VAL-MATCH-V1 endpoints require an approved production key).
RIOT_API_KEY=

# Kaggle credentials. Two options, pick one:
#
#   1. (recommended) %USERPROFILE%\.kaggle\kaggle.json, the file you get from
#      https://www.kaggle.com/settings -> Create New Token. Works for both
#      `vct download-kaggle` and the bare `kaggle` CLI.
#
#   2. The two vars below. Only picked up by code that imports vct_quant.config
#      first (it calls load_dotenv, and subprocess inherits the environment), so
#      `vct download-kaggle` sees them but a bare `kaggle` command will not.
#
# Uncomment for option 2 ONLY. The kaggle client copies every KAGGLE_* var over
# whatever it already read from kaggle.json, and treats a present-but-empty
# username/key as valid credentials -- so leaving these uncommented and blank
# turns a working option 1 into a 401.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
